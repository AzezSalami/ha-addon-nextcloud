#!/usr/bin/env bash
# nc-backup create  [--label L] [--offline]
# nc-backup verify  <backup-dir> [--data-against-live]
# nc-backup list
# nc-backup restore <backup-dir> --yes-restore
#
# A backup directory contains: db.sql.gz, config.tar.gz (config, custom_apps, themes), apps.json,
# data/ (rsync snapshot, hard-linked against the previous snapshot), SHA256SUMS, manifest.json.
# Backups never contain plaintext copies of options.json; the DB dump and config.php DO contain
# secrets (dbpassword, secret, passwordsalt) - protect the backup location.
set -Eeuo pipefail
# shellcheck source=/dev/null
. /usr/local/lib/nc-addon/common.sh

BASE="${NC_BACKUP_DIR:-/backup/nextcloud_official}"
CFG="$NC_WEBROOT/config/config.php"
umask 077

need_installed() { nc_installed || die "Nextcloud is not installed; nothing to back up/restore."; }

maint() { # maint on|off  (skipped for --offline)
    [ "${OFFLINE:-0}" = 1 ] && return 0
    occ maintenance:mode --"$1" >/dev/null
}

cmd_create() {
    local label="" ts dir prev datadir
    OFFLINE=0
    while [ $# -gt 0 ]; do
        case "$1" in --label) label="$2"; shift ;; --offline) OFFLINE=1 ;; *) die "unknown option $1" ;; esac; shift
    done
    need_installed
    db_connect_from_config "$CFG"
    datadir="$(cfg_get "$CFG" datadirectory)"
    [ -d "$datadir" ] || die "data directory '$datadir' missing"
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    dir="$BASE/$ts${label:+-$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_')}"
    mkdir -p "$dir"
    prev="$(find "$BASE" -mindepth 1 -maxdepth 1 -type d -name '*Z*' ! -path "$dir" 2>/dev/null | sort | tail -n1 || true)"

    log info "Backup -> $dir"
    maint on
    # always leave maintenance mode, even when something fails
    trap 'maint off || true' EXIT
    local ok=1
    {
        mariadb-dump --single-transaction --quick --default-character-set=utf8mb4 --routines \
            -h "$DBH" -P "$DBP" -u "$DBU" "$DBN" | gzip -9 >"$dir/db.sql.gz" \
        && tar -czf "$dir/config.tar.gz" -C "$NC_WEBROOT" config $( [ -d "$NC_WEBROOT/custom_apps" ] && echo custom_apps ) $( [ -d "$NC_WEBROOT/themes" ] && echo themes ) \
        && { occ app:list --output=json >"$dir/apps.json" 2>/dev/null || echo '{}' >"$dir/apps.json"; } \
        && mkdir -p "$dir/data" \
        && rsync -a ${prev:+--link-dest="$prev/data"} "$datadir"/ "$dir/data"/
    } || ok=0
    if [ "$ok" = 1 ]; then
        ( cd "$dir" && sha256sum db.sql.gz config.tar.gz apps.json >SHA256SUMS )
        jq -n --arg ts "$ts" --arg v "$(nc_code_version)" --arg db "$DBN" --arg dd "$datadir" --arg arch "$(detect_arch)" \
            '{created:$ts, nextcloud:$v, database:$db, datadirectory:$dd, architecture:$arch, format:1}' >"$dir/manifest.json"
        verify_dir "$dir" live || ok=0
    fi
    maint off; trap - EXIT
    if [ "$ok" != 1 ]; then
        mv "$dir" "$dir.FAILED" 2>/dev/null || true
        die "Backup FAILED and was not verified ($dir.FAILED kept for inspection)"
    fi
    touch "$dir/.verified"
    log info "Backup complete and verified: $dir ($(du -sh "$dir" | cut -f1))"
    echo "$dir"
}

# verify_dir <dir> [live]  - integrity checks; "live" additionally diffs data against the live data dir.
verify_dir() {
    local dir="$1" mode="${2:-}" rc=0 diffout
    [ -d "$dir" ] || { log error "no such backup: $dir"; return 1; }
    ( cd "$dir" && sha256sum -c SHA256SUMS >/dev/null 2>&1 ) || { log error "checksum mismatch"; rc=1; }
    gzip -t "$dir/db.sql.gz" 2>/dev/null || { log error "db.sql.gz is corrupt"; rc=1; }
    zcat "$dir/db.sql.gz" | tail -n 5 | grep -q 'Dump completed' || { log error "DB dump is truncated (no completion marker)"; rc=1; }
    tar -tzf "$dir/config.tar.gz" >/dev/null 2>&1 || { log error "config.tar.gz is corrupt"; rc=1; }
    tar -tzf "$dir/config.tar.gz" | grep -q 'config/config.php' || { log error "config.php missing from archive"; rc=1; }
    [ -d "$dir/data" ] || { log error "data snapshot missing"; rc=1; }
    if [ "$mode" = live ]; then
        local datadir; datadir="$(cfg_get "$CFG" datadirectory)"
        diffout="$(rsync -rcn --itemize-changes "$datadir"/ "$dir/data"/ 2>/dev/null | grep -v '^\.d' | head -n 5 || true)"
        [ -z "$diffout" ] || { log error "data snapshot differs from source: $diffout"; rc=1; }
    fi
    [ "$rc" = 0 ] && log info "verify OK: $dir"
    return $rc
}

cmd_verify() {
    local dir="${1:?backup dir}"; shift || true
    local mode=""
    [ "${1:-}" = "--data-against-live" ] && { db_connect_from_config "$CFG"; mode=live; }
    verify_dir "$dir" "$mode"
}

cmd_list() {
    [ -d "$BASE" ] || { echo "(no backups in $BASE)"; return 0; }
    for d in "$BASE"/*/; do
        [ -d "$d" ] || continue
        printf '%s  %s\n' "$([ -f "$d/.verified" ] && echo verified || echo UNVERIFIED)" "${d%/}"
    done
}

cmd_restore() {
    local dir="${1:?backup dir}"; shift || true
    [ "${1:-}" = "--yes-restore" ] || die "Restore replaces the current database, data and config. Re-run with --yes-restore after reading docs/BACKUP-RESTORE.md."
    verify_dir "$dir" || die "Backup does not verify; refusing to restore."
    need_installed
    db_connect_from_config "$CFG"
    local datadir; datadir="$(cfg_get "$CFG" datadirectory)"
    log warning "Creating safety backup of the CURRENT state before restoring"
    cmd_create --label pre-restore >/dev/null || die "Safety backup failed; aborting restore."

    occ maintenance:mode --on >/dev/null
    log info "Restoring database"
    mariadb -h "$DBH" -P "$DBP" -u "$DBU" -e "DROP DATABASE \`$DBN\`; CREATE DATABASE \`$DBN\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci"
    zcat "$dir/db.sql.gz" | mariadb -h "$DBH" -P "$DBP" -u "$DBU" "$DBN"
    log info "Restoring data"
    rsync -a --delete "$dir/data"/ "$datadir"/
    log info "Restoring config, custom_apps and themes"
    tar -xzf "$dir/config.tar.gz" -C "$NC_WEBROOT"
    chown -R www-data:www-data "$datadir" "$NC_WEBROOT/config"
    occ maintenance:mode --off >/dev/null
    occ maintenance:data-fingerprint >/dev/null || true
    log info "Restore finished. Verify: nc-diag"
}

case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    verify) shift; cmd_verify "$@" ;;
    list) cmd_list ;;
    restore) shift; cmd_restore "$@" ;;
    *) sed -n '2,5p' "$0"; exit 2 ;;
esac
